{
  "manifest_version": 3,
  "key": "",
  "name": "유튜브 재생목록 북마크",
  "version": "4.7.0",
  "description": "YouTube 재생목록에 북마크를 넣어 클릭 점프. 영상을 북마크 밑으로 이동, 이름 변경·검색·한 칸 이동·북마크 순서 바꾸기 지원.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "유튜브 재생목록 북마크 (켜기/끄기)"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
